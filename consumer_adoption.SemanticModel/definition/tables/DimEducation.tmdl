table DimEducation
	lineageTag: d3094c4a-5843-4945-97ec-78734bfbed89

	column EDU
		dataType: int64
		formatString: 0
		lineageTag: cef31ac5-c6f1-4ef0-9dbd-fd7fca233557
		summarizeBy: none
		sourceColumn: EDU

		annotation SummarizationSetBy = Automatic

	column 'Education Level' =
			
			VAR Code = DimEducation[EDU]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Code), "Missing",
			        Code = 1, "Primary school",
			        Code = 2, "Junior high school",
			        Code = 3, "Senior high school",
			        Code = 4, "Bachelor's degree",
			        Code = 5, "Master's degree",
			        "Undocumented (" & FORMAT(Code, "0") & ")"
			    )
		lineageTag: 49b70146-9cbf-41cf-a30b-a2fcf0a63915
		summarizeBy: none
		sortByColumn: EDU

		changedProperty = IsHidden

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	partition DimEducation = m
		mode: import
		source =
				let
				  Source = Proccessed_data_CSV,
				  #"Removed other columns" = Table.SelectColumns(Source, {"EDU"}),
				  #"Removed duplicates" = Table.Distinct(#"Removed other columns", {"EDU"}),
				  #"Sorted rows" = Table.Sort(#"Removed duplicates", {{"EDU", Order.Ascending}})
				in
				  #"Sorted rows"

	annotation PBI_ResultType = Table

